{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "declaration": true,
    "emitDeclarationOnly": true,

    "outDir": "./types",
    "rootDir": "./src",

    "declaration": true,
    "emitDeclarationOnly": true,

    "skipLibCheck": true,
    "strict": true
  },

  "include": [
    "src/index.ts",
    "src/components/**/*"
  ],

  "exclude": [
    "**/*.stories.tsx",
    ".storybook",
    "dist",
    "node_modules"
  ]
}